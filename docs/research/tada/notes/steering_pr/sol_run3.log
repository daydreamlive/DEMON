  border-radius: 5px;
  color: #f1f1ed;
  cursor: pointer;
  font-size: 12px;
  font-weight: 900;
  min-height: 32px;
  text-transform: uppercase;
}

.send-btn {
  justify-self: end;
  padding: 0 16px;
}

.send-btn:disabled,
.power-btn:disabled {
  cursor: default;
  opacity: 0.45;
}

.title {
  background: linear-gradient(180deg, #c9c9be, #878b89);
  border: 1px solid #4d5557;
  border-radius: 3px;
  box-shadow: inset 0 1px rgb(255 255 255 / 55%), 0 3px 5px rgb(0 0 0 / 45%);
  color: #172026;
  font-size: 30px;
  font-weight: 900;
  justify-self: center;
  line-height: 1;
  padding: 6px 20px;
  text-shadow: 0 1px rgb(255 255 255 / 35%);
}

.transport {
  align-items: center;
  display: flex;
  gap: 10px;
  justify-content: center;
  min-height: 36px;
}

.power-btn {
  min-width: 88px;
}

.power-on {
  border-color: rgb(107 160 205 / 70%);
  box-shadow: 0 0 12px rgb(107 160 205 / 30%);
}

.tick-readout {
  align-items: baseline;
  background: #101112;
  border: 1px solid rgb(255 255 255 / 14%);
  border-radius: 4px;
  color: #f1f1ed;
  display: inline-flex;
  font-size: 12px;
  font-variant-numeric: tabular-nums;
  gap: 4px;
  justify-content: center;
  min-height: 30px;
  min-width: 92px;
  padding: 7px 8px 0;
}

.tick-readout b,
.tick-readout small {
  color: #8f938f;
  font-size: 9px;
  font-weight: 900;
  text-transform: uppercase;
}

.status-dot {
  border-radius: 50%;
  height: 9px;
  width: 9px;
}

.status-idle {
  background: #5a5f66;
}

.status-connecting {
  animation: sa3-pulse 1.1s ease-in-out infinite;
  background: #d9b54a;
}

.status-ready {
  background: #5fd97e;
  box-shadow: 0 0 8px rgb(95 217 126 / 55%);
}

.status-error {
  background: #e0524d;
  box-shadow: 0 0 8px rgb(224 82 77 / 55%);
}

.status-text {
  color: #c9cbc6;
  font-size: 12px;
}

@keyframes sa3-pulse {
  50% {
    opacity: 0.35;
  }
}

@media (max-width: 1200px) {
  .shell {
    flex-direction: column;
    gap: 40px;
  }
}

@media (max-width: 620px) {
  .shell {
    padding: 18px 20px;
  }

  .plugin {
    padding: 18px 22px;
  }

  .plugin::before,
  .plugin::after {
    width: 28px;
  }

  .source-row {
    grid-template-columns: 1fr;
  }

  .plugin-steer .knob-cell {
    flex-basis: calc((100% - 20px) / 3);
  }
}

@media (max-width: 380px) {
  .knob-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .plugin-steer .knob-cell {
    flex-basis: calc((100% - 10px) / 2);
  }
}

