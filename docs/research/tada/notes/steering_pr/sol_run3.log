          </label>

          <div class="source-row">
            <label class="field-slot">
              <span>Source</span>
              <select id="fixture"></select>
            </label>
            <label class="field-slot duration-slot">
              <span>Duration s</span>
              <input id="duration" type="number" min="1" max="120" placeholder="auto">
            </label>
          </div>

          <button id="send-prompt" type="button" class="send-btn" disabled>Send Prompt</button>
        </div>

        <div class="title">sa3</div>

        <div class="transport">
          <button id="transport" type="button" class="power-btn">Start</button>
          <span class="tick-readout" title="Backend tick time">
            <b>tick</b>
            <span id="tick">--.-</span>
            <small>ms</small>
          </span>
          <span id="status-dot" class="status-dot status-idle" aria-hidden="true"></span>
          <span id="status-text" class="status-text">idle</span>
        </div>
      </section>
      <section id="steer-pedal" class="plugin plugin-steer" aria-label="Activation steering pedal" hidden>
        <div class="screws" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        <div class="brand-row">
          <div class="brand">Daydream</div>
        </div>
        <div id="steer-knobs" class="knob-grid"></div>
        <div class="title">STEER</div>
      </section>
    </main>

    <script type="module" src="./sa3.js"></script>
  </body>
</html>

