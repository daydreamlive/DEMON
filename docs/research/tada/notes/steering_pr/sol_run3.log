def knobs(names):
    return ''.join(f'<div class=\"knob-cell\"><div class=\"knob-wrap\"><div class=\"knob\"><div class=\"pointer-rotor\"><div class=\"knob-pointer\"></div></div></div></div><div class=\"knob-value\">0.50</div><div class=\"knob-label\">{name}</div></div>' for name in names)
html = html.replace('<div class=\"knob-placeholder\">knobs appear when the session starts</div>', knobs(['noise', 'strength', 'steps', 'tempo', 'pitch', 'mix']))
