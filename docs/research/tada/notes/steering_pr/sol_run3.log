 demos/sa3/styles.css | 238 +++++++++++++++++++++++++--------------------------
 1 file changed, 119 insertions(+), 119 deletions(-)
* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  min-height: 100%;
}

body {
  background:
    radial-gradient(circle at 50% 18%, rgb(255 255 255 / 10%), transparent 26%),
    radial-gradient(circle at 50% 86%, rgb(107 160 205 / 12%), transparent 32%),
    linear-gradient(145deg, #14171b, #050607 72%);
  color: #f1f1ed;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button,
input,
select,
textarea {
  font: inherit;
}

.shell {
  align-items: center;
  display: flex;
  gap: 3.25rem;
  justify-content: center;
  min-height: 100svh;
  padding: 1.5rem;
}

.plugin {
  background:
    radial-gradient(circle at 50% 16%, rgb(255 255 255 / 8%), transparent 34%),
    linear-gradient(180deg, #30343a, #15181d 52%, #08090b);
  border: 0.0625rem solid #565d66;
  border-radius: 0.5rem;
  box-shadow:
    inset 0 0.0625rem 0 rgb(255 255 255 / 18%),
    inset 0 -14px 1.875rem rgb(0 0 0 / 46%),
    0 1.75rem 5rem rgb(0 0 0 / 52%);
  display: grid;
  gap: 1rem;
  min-width: 0;
  padding: 1.625rem 2rem 1.5rem;
  position: relative;
  width: min(100%, 35rem);
}

.plugin[hidden] {
  display: none;
}

.plugin-steer {
  background:
    radial-gradient(circle at 50% 16%, rgb(255 255 255 / 10%), transparent 34%),
    linear-gradient(180deg, #384850, #1c2c34 52%, #0b1319);
  border-color: #6b8792;
}

.plugin::before,
.status-error {
  background: #e0524d;
  box-shadow: 0 0 0.5rem rgb(224 82 77 / 55%);
}

.status-text {
  color: #c9cbc6;
  font-size: 0.75rem;
}

@keyframes sa3-pulse {
  50% {
    opacity: 0.35;
  }
}

@media (max-width: 1200px) {
  .shell {
    flex-direction: column;
    gap: 2.5rem;
  }
}

@media (max-width: 620px) {
  .shell {
    padding: 1.125rem 1.25rem;
  }

  .plugin {
    padding: 1.125rem 1.375rem;
  }

  .plugin::before,
  .plugin::after {
    width: 1.75rem;
  }

  .source-row {
    grid-template-columns: 1fr;
  }

  .plugin-steer .knob-cell {
    flex-basis: calc((100% - 1.25rem) / 3);
  }
}

@media (max-width: 380px) {
  .knob-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .plugin-steer .knob-cell {
    flex-basis: calc((100% - 0.625rem) / 2);
  }
}

