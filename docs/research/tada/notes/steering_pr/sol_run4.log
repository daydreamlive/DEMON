    inset 0 -0.5625rem 0.9375rem rgb(0 0 0 / 62%),
    0 0.5rem 0.875rem rgb(0 0 0 / 62%);
  cursor: grab;
  display: flex;
  height: 4.75rem;
  justify-content: center;
  position: relative;
  /* Claim vertical-drag gestures so touch devices steer the knob
     instead of scrolling the page. */
  touch-action: none;
  user-select: none;
  width: 4.75rem;
}

.knob:focus-visible {
  outline: 0.125rem solid #6ba0cd;
  outline-offset: 0.1875rem;
}

.knob.dragging {
  cursor: ns-resize;
}

/* While dragging, kill the rotor's settle animation so the pointer
   tracks the cursor 1:1 instead of easing behind it. */
.knob.dragging .pointer-rotor {
  transition: none;
}

/* A drag started on a knob can travel anywhere via pointer capture;
   pin the resize cursor and suppress text selection page-wide. */
body.knob-dragging {
  cursor: ns-resize;
  user-select: none;
}

.knob::before {
  border: 0.125rem solid rgb(255 255 255 / 74%);
  border-radius: 50%;
  content: "";
  height: 2.125rem;
  position: absolute;
  width: 2.125rem;
}

.pointer-rotor {
  inset: 0;
