.knob {
  align-items: center;
  background:
    radial-gradient(circle at 38% 32%, #5c626b, transparent 22%),
    radial-gradient(circle at 62% 72%, #050607, transparent 34%),
    linear-gradient(135deg, #30353d, #070809);
